# === Eazo platform base (shared by @eazo/sdk and grant exchange) ===
# Platform root only — no /creator/api suffix:
#   - @eazo/sdk appends /api/apps-open etc.
#   - grant code uses /creator/api/webagent/grant
# Local: http://localhost:8000   Production: https://eazo.ai
EAZO_PLATFORM_API_BASE=https://eazo.ai

# Optional: override WebAgent host (usually returned by the platform)
# QONI_WEBAGENT_HOST=

# === Eazo app auth (requireAuth) ===
# requireAuth reads x-eazo-session and decrypts with this private key.
EAZO_PRIVATE_KEY=

# Host app id for EazoProvider and platform grant (x-eazo-app-id).
# Non-empty placeholder for local dev; use the real app id in production.
EAZO_APP_ID=
NEXT_PUBLIC_EAZO_APP_ID=
